# E2E Test Environment Configuration
#
# Copy this file to .env.e2e and fill in the values.
# NEVER commit actual credentials.

# Frontend URL for E2E tests (local dev server)
E2E_FRONTEND_URL=http://localhost:5174

# Backend URL for E2E tests (local test backend)
E2E_BACKEND_URL=http://localhost:3001

# Path to backend repository (relative or absolute)
E2E_BACKEND_DIR=../backend

# Optional: Override database connection for E2E
# These will be read from backend/.env by default
# E2E_DB_HOST=localhost
# E2E_DB_PORT=5432
# E2E_DB_NAME=appliances_test
# E2E_DB_USERNAME=postgres
# E2E_DB_PASSWORD=your_password

# Note: Test accounts are created dynamically during test execution.
# No credentials need to be stored here.
