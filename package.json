{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:commerce:e2e": "playwright test --config playwright.commerce.config.cjs",
    "test:redesign:e2e": "playwright test --config playwright.redesign.config.cjs",
    "test:ai:e2e": "playwright test --config playwright.ai.config.cjs",
    "test:experience:e2e": "playwright test --config playwright.experience.config.cjs",
    "test:catalog": "node --test test/catalog.test.cjs",
    "test:catalog:e2e": "playwright test --config playwright.catalog.config.cjs",
    "test:home:e2e": "playwright test --config playwright.home.config.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:checkout": "node --test test/checkout.test.cjs",
    "test:checkout:e2e": "playwright test --config playwright.checkout.config.cjs",
    "test:cart": "node --test test/cart.test.cjs",
    "test:cart:e2e": "playwright test --config playwright.cart.config.cjs",
    "test:auth": "node --test test/auth-redirect.test.cjs",
    "test:products": "node --test test/product-details.test.cjs",
    "test:product-edit": "node --test test/product-edit.test.cjs",
    "test:orders:e2e": "playwright test --config playwright.orders.config.cjs",
    "test:admin-orders:e2e": "playwright test --config playwright.admin-orders.config.cjs",
    "test:chat:e2e": "playwright test --config playwright.chat.config.cjs",
    "test:ui:e2e": "playwright test --config playwright.ui.config.cjs",
    "test:ui:regression": "node test/run-ui-regression.cjs",
    "test:ui:chat": "playwright test --config playwright.ui-chat.config.cjs",
    "test:themes": "node --test test/themes.test.cjs",
    "test:themes:e2e": "playwright test --config playwright.themes.config.cjs",
    "test:promotions:e2e": "playwright test --config playwright.promotions.config.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
